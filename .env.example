# Server-side environment variables
# Copy this file to .env and fill in real values when you connect an AI provider.

# AI provider key (used by /api/chat when you wire up a real provider)
AI_API_KEY=

# Flask secret key for session signing
SECRET_KEY=change-me-in-production

# GitHub username for the activity/projects section (public, not a secret)
GITHUB_USERNAME=

# Optional: GitHub personal access token for higher API rate limits
GITHUB_TOKEN=
